DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=paperclip-dev-secret

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Stripe billing — required for the commercial SaaS billing layer.
# Get these from the Stripe Dashboard: https://dashboard.stripe.com/apikeys
# Secret API key (starts with `sk_test_` or `sk_live_`). Never expose to the browser.
STRIPE_SECRET_KEY=sk_test_replace_me
# Webhook signing secret from the Stripe webhook endpoint settings
# (https://dashboard.stripe.com/webhooks). Starts with `whsec_`.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Stripe Price IDs for each plan. Create recurring (monthly) products in Stripe and
# copy the price IDs (start with `price_`) from https://dashboard.stripe.com/products.
STRIPE_STARTER_PRICE_ID=price_replace_me_starter
STRIPE_GROWTH_PRICE_ID=price_replace_me_growth
STRIPE_SCALE_PRICE_ID=price_replace_me_scale
# Stripe Connect — required for the reseller/partner program. Use the Express
# platform client id from https://dashboard.stripe.com/settings/connect. Starts
# with `ca_`.
STRIPE_CONNECT_CLIENT_ID=ca_replace_me
# Webhook signing secret for the Stripe Connect platform webhook that receives
# connected-account events (account.updated, payment.*) for the reseller program.
# Create a separate endpoint pointing at `/api/reseller/webhook` at
# https://dashboard.stripe.com/webhooks/connect and copy the signing secret here.
STRIPE_WEBHOOK_SECRET_CONNECT=whsec_replace_me_connect
# Public base URL used to build partner onboarding return links and referral URLs.
# APP_URL=http://localhost:3000

# Path to the whitelabel branding config. Defaults to searching for
# whitelabel.config.ts / .js / .json at the repo root. Set this to an
# absolute path to point at a config outside the repo (useful when shipping
# the server as a package), or to a non-existent path to disable branding
# overrides entirely.
# WHITELABEL_CONFIG_PATH=/etc/myproduct/whitelabel.config.json

# Voice/Phone Agent (Twilio + Deepgram + ElevenLabs) — required for the voice plugin.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Twenty CRM (optional) — when configured, customer writes are mirrored to your
# Twenty instance. Leave unset to run Customer 360 with local memory only.
TWENTY_INTERNAL_URL=http://twenty:3000
TWENTY_API_KEY=

# Postiz (self-hosted social-media scheduler) — runs as a Docker sidecar.
# See https://github.com/gitroomhq/postiz-app for docker-compose setup.
POSTIZ_INTERNAL_URL=http://postiz:3000
POSTIZ_API_KEY=

# Wonda (CLI-based marketing agent) — chains 20+ AI models (Sora, ElevenLabs,
# Kling, Suno) into marketing workflows. Install separately:
#   npm install -g @degausai/wonda
WONDA_API_KEY=

# Aider self-healing coding agent (https://aider.chat). Developer/power-user
# feature — disabled by default and hidden from regular SMB users. Install the
# Aider CLI with `pip install aider-chat` before enabling.
# AIDER_ENABLED=true exposes the /api/aider/* routes (otherwise they 404).
AIDER_ENABLED=false
AIDER_MODEL=claude-3-5-sonnet-20241022
# AIDER_AUTO_FIX_ENABLED=true lets the Guardian watchdog log `aider_fix_dispatched`
# incidents when an agent accumulates 10+ quality issues in 24h (Aider is not
# invoked directly — an agent picks up the incident later).
AIDER_AUTO_FIX_ENABLED=false

# Goose CLI: https://github.com/block/goose
# Autonomous multi-step agent tasks. Install the Goose CLI
# (`pip install goose-ai` or download from GitHub releases) before enabling.
# GOOSE_ENABLED=true exposes the /api/goose/* routes and the /autonomous-tasks UI.
GOOSE_ENABLED=true
# Override the binary path/name if `goose` is not on PATH.
# GOOSE_BIN=/usr/local/bin/goose

# VITE_DEV_MODE=true reveals the /dev-tools page and its sidebar entry in the UI.
VITE_DEV_MODE=false
