{
  "name": "@paperclipai/plugin-email",
  "version": "0.1.0",
  "description": "Unified email plugin for Gmail and Microsoft Outlook with OAuth2 and agent tools",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./providers/gmail": "./src/providers/gmail.ts",
    "./providers/outlook": "./src/providers/outlook.ts"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js"
  },
  "scripts": {
    "prebuild": "node ../../../scripts/ensure-plugin-build-deps.mjs",
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "pnpm --filter @paperclipai/plugin-sdk build && tsc --noEmit"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.7.3"
  }
}
